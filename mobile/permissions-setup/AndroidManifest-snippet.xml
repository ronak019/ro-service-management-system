<!--
  Add these inside <manifest> in android/app/src/main/AndroidManifest.xml,
  above the <application> tag.
-->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.RECORD_AUDIO" />
<uses-permission android:name="android.permission.CAMERA" />

<!-- Android 12 and below only need these for gallery access; on Android 13+
     the system photo picker (used by react-native-image-picker) doesn't
     require broad storage permission. Keep for backward compatibility. -->
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
