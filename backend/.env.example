# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The Next.js admin app + your public web domain. NEVER use "*" in production
# because cookies/tokens would then be readable cross-origin.
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_REFRESH_SECRET=change_this_to_another_strong_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ro_service

# Public web app (used to build customer report links)
FRONTEND_URL=https://yourdomain.com

# S3 / R2 compatible storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET
AWS_BUCKET=your-ro-reports-bucket
# Only needed for R2 / non-AWS S3-compatible endpoints. Leave unset for real AWS S3.
AWS_S3_ENDPOINT=

# Set to true if bucket objects are private and you want the API to hand back
# pre-signed GET URLs instead of raw bucket URLs.
S3_PRIVATE_BUCKET=false

# First admin bootstrap (used only by scripts/create-admin.js)
BOOTSTRAP_ADMIN_PHONE=9999999999
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
